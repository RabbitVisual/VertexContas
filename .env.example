APP_NAME="Vertex Contas"
APP_ENV=local
APP_KEY=base64:NbYz4KlZcHMquKbn5Ho0BKkPLg7/22NbudZh/Ggzq1k=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt-BR
APP_FALLBACK_LOCALE=pt-BR
APP_FAKER_LOCALE=pt-BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (padrão dev/local - path relativo ao base_path)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# SQLite - otimizações recomendadas (Laravel usa via config/database.php)
# busy_timeout: ms para esperar lock (10000 = 10s evita "database is locked")
# journal_mode: WAL = melhor concorrência leitura/escrita
# synchronous: NORMAL = equilíbrio seguranca/performance (FULL = mais seguro, mais lento)
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# MySQL/PostgreSQL (descomente e ajuste se usar em produção)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vertex_contas
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=pusher # Use for Vertex Chat VIP real-time

# Pusher (Vertex Chat VIP - set when using real-time)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CI/CD & Testing
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
# TELESCOPE_ENABLED=false
# PULSE_ENABLED=false

# Google reCAPTCHA v3 (Admin > Configurações > Segurança - grátis em https://www.google.com/recaptcha/admin)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# =============================================================================
# Jules AI (Google) - https://jules.google.com
# =============================================================================
# API Key: gere em https://jules.google.com/settings (max 3 chaves ativas)
# Uso: Jules REST API, integração CI/CD, automação via GitHub Actions
# Repo vars: configure em Repository Settings > Environment Variables no Jules
# GitHub: adicione JULES_API_KEY nos Secrets para workflows (jules-auto-merge.yml)
JULES_API_KEY=

# Google Gemini API (Vertex Bot - Admin > Configurações > IA)
# Fallback when not set in Panel; get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
